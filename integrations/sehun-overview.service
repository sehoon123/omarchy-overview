[Unit]
Description=Resident Mission Control overview; captures only while visible
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
Environment=OVERVIEW_START_HIDDEN=1
ExecStart=/usr/bin/quickshell -p %h/.config/omarchy/overview --no-duplicate
ExecStop=%h/.local/bin/omarchy-overview --shutdown
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
