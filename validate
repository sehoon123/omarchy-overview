#!/usr/bin/env bash
# Headless checks only. No compositor actions or changes to desktop settings.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
for file in ./*.qml; do /usr/lib/qt6/bin/qmlformat "$file" >/dev/null; done
# Lists that crossed a QML `var` signal fail Array.isArray() on Qt 6.12.
if grep -nE 'Array\.isArray\(|instanceof Array' shell.qml; then
  echo 'validate: shell.qml must read signal-crossed lists with OverviewLogic.listOf(), not Array.isArray()' >&2
  exit 1
fi
node Layout.test.js
node OverviewLogic.test.js
/usr/bin/python3 -m unittest discover -s tests -p 'test_*.py' -v
QT_QPA_PLATFORM=offscreen QT_IM_MODULE=compose QT_QUICK_BACKEND=software \
  /usr/lib/qt6/bin/qmltestrunner -input tests -o -,txt
# shell.qml itself, against stand-ins for Quickshell's modules (tests/shell-harness).
tests/shell-harness/build
QT_QPA_PLATFORM=offscreen QT_IM_MODULE=compose QT_QUICK_BACKEND=software \
  /usr/lib/qt6/bin/qmltestrunner -import tests/shell-harness/stubs -input tests/shell-harness/harness.qml -o -,txt
