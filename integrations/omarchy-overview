#!/usr/bin/env bash
# Toggle the resident, user-owned overview. It captures only while visible and
# keeps no frame cache; window images live in the running process and nowhere else.
set -euo pipefail
config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/overview"

# Every child gets the whole time left, so a call that timed out has used up the
# deadline and nothing can retry it. time_left fails once nothing is left,
# because `timeout 0` would never expire.
deadline() { limit=$1 left=$1 ends=$((${EPOCHREALTIME//[!0-9]/} + $1 * 1000000)); }
time_left() {
  local us=$((ends - ${EPOCHREALTIME//[!0-9]/}))
  ((us > 0)) && printf -v left '%d.%06d' $((us / 1000000)) $((us % 1000000))
}

# `quickshell ipc call` (0.3.2) exits 255 with a line `No running instances for`
# when no instance of this config runs on this display, and adds `Some instances
# on other displays match:` when one runs elsewhere. Under a non-UTF-8 locale Qt
# prints a warning on stdout before everything else, so the client runs under
# C.UTF-8 and the reply is the last line. A live instance that is busy or frozen
# never answers, and it still runs the request once it can, so a call that timed
# out after an answer may still take effect. After an IPC error the instance was
# out of reach, so the timeout is the deadline cutting the next call short and
# the error stays the outcome.
outcome='' answer=''
ipc() {
  local out status=0
  out="$(NO_COLOR=1 LC_ALL=C.UTF-8 timeout "$left" quickshell ipc -p "$config" call overview "$@" 2>/dev/null)" || status=$?
  ((status == 124)) && [[ $outcome == ipc-error ]] && return
  reply=${out##*$'\n'}
  if ((status == 0)); then outcome=answered answer=$reply
  elif ((status == 124)); then outcome=no-answer
  elif [[ $'\n'$out == *$'\n''No running instances for '* && $out != *'Some instances on other displays match:'* ]]; then
    outcome=not-running
  else outcome=ipc-error reply=${out:-"quickshell ipc exited $status"}
  fi
}

# A keybinding discards stderr, so a failed press also shows one notification.
# A notification stays in the notification history, so it shows the sentence $1
# alone. The detail $2 is text another program printed, which can name a
# workspace or a path, and it goes to stderr only.
fail_press() {
  echo "omarchy-overview: $1${2:+: $2}" >&2
  timeout 1 notify-send -a Overview -u normal -- "$1" 2>/dev/null || true
  exit 1
}

fail_ipc() {
  local detail
  read -r detail <<<"$reply" || true
  case $outcome in
    no-answer) fail_press "Overview did not answer within $limit seconds${answer:+ (last answer: $answer)}" ;;
    not-running) fail_press "Overview did not start within $limit seconds" ;;
    answered) fail_press "Overview did not accept the request: $detail" ;;
    ipc-error) fail_press "Overview could not be reached" "$detail" ;;
  esac
}

start_overview() {
  time_left || return 0
  timeout "$left" systemctl --user start sehun-overview.service && return 0
  time_left || return 0
  timeout "$left" env OVERVIEW_START_HIDDEN=1 quickshell -p "$config" --no-duplicate --daemonize 9>&- || true
}

# The unit runs `--shutdown ${MAINPID}`, and systemd leaves $MAINPID unset once it
# saw the main process exit.
main_gone() { (($#)) && { [[ -z $1 ]] || ! kill -0 "$1" 2>/dev/null; }; }

if [[ "${1:-}" == --shutdown ]]; then
  deadline 7
  call=shutdown
  ipc shutdown
  until [[ $outcome == not-running ]] || main_gone "${@:2}"; do
    [[ $outcome == answered && $reply == ok ]] && call=status
    sleep .03
    if ! time_left; then echo "omarchy-overview: Overview did not stop within $limit seconds" >&2; exit 1; fi
    ipc "$call"
  done
  exit 0
fi

mode='' direction=''
case "${1:-}" in
  --next|--previous) direction="${1#--}" lock=sehun-overview-step ;;
  --app) mode=app lock=sehun-overview ;;
  "") lock=sehun-overview ;;
  *) echo 'Usage: omarchy-overview [--app|--next|--previous|--shutdown [MAINPID]]' >&2; exit 2 ;;
esac
exec 9>"${XDG_RUNTIME_DIR:?}/$lock.lock"
flock -n 9 || exit 0
deadline 2
# Never summon previews into a locked session.
timeout "$left" omarchy-hyprland-session-locked && exit 0
time_left || fail_press "The session lock check did not finish within $limit seconds"

if [[ -n $direction ]]; then
  # Logic.ipcGuard() in OverviewLogic.js answers navigateDesktop `ok` exactly when
  # the step took effect, and none of its refusals has a side effect.
  ipc navigateDesktop "$direction"
  while [[ $outcome == answered && $reply != ok && $reply != unavailable ]]; do
    sleep .025
    time_left || fail_ipc
    ipc navigateDesktop "$direction"
  done
  case $outcome in
    answered) [[ $reply == unavailable ]] || exit 0 ;;
    no-answer|ipc-error) fail_ipc ;;
  esac
  time_left || fail_press "Overview did not switch desktops within $limit seconds"
  out=$(timeout "$left" /usr/bin/python3 "$config/controller.py" step "$direction") && exit 0 || status=$?
  ((status == 124)) && fail_press "The desktop switch did not finish within $limit seconds"
  fail_press "The desktop switch failed" "${out:-controller.py exited $status}"
fi

# Warm path: one IPC request, no process restart or hyprctl/jq context probes.
# While its config loads, quickshell answers `Not ready to accept queries yet.`
# without calling the handler.
started=''
ipc toggle "$mode"
until [[ $outcome == answered && $reply == ok ]]; do
  if [[ $outcome == not-running && -z $started ]]; then started=1; start_overview; fi
  sleep .025
  time_left || fail_ipc
  ipc toggle "$mode"
done
